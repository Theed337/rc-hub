{
  "name": "rc-hub",
  "version": "0.0.0",
  "private": true,
  "description": "RC Hub — Enterprise Platform Monorepo",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:studio": "pnpm --filter @rc-hub/database db:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  }
}
